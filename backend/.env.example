PG_USER=
PG_HOST=
PG_DATABASE=
PG_PASSWORD=
PG_PORT=

# --- Server ---
PORT=5001
# Where the React dev server runs. Used for the CORS allowlist and as the
# redirect target after a successful login.
CLIENT_URL=http://localhost:5173

# --- Sessions ---
# Signs the session cookie. Any long random string; changing it invalidates
# every existing session. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Google OAuth ---
# From https://console.cloud.google.com/apis/credentials
# Create an "OAuth client ID" of type "Web application", then register
# GOOGLE_CALLBACK_URL below as an Authorized redirect URI — it has to match
# exactly, including the port and path.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
